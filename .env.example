# Aplikasi
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# URL publik aplikasi. Di Render bisa dikosongkan karena otomatis
# memakai RENDER_EXTERNAL_URL. Untuk lokal: http://localhost:8000
APP_URL=

# Prefix path bila aplikasi tidak berada di root domain. Untuk Render: kosong.
APP_BASE_PATH=

# Base URL asset. Default: APP_URL + "/".
BASE_ASSETS=

# Database MySQL (Aiven free / TiDB Serverless)
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=mvcomp
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_SSL=true
DB_SSL_CA=/var/www/config/ca.pem
DB_SSL_VERIFY=true

# Admin awal (dipakai scripts/create-admin.php, idempotent)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-password-ini

# Midtrans (sandbox)
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false
